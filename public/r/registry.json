{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "nk",
  "homepage": "https://ui.nimakhabbazi.com",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "Shared cn() helper for merging Tailwind classes.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "breadcrumb",
      "type": "registry:ui",
      "title": "Breadcrumb",
      "description": "Composable breadcrumb primitives for icons, separators, ellipsis, and custom links.",
      "dependencies": ["@radix-ui/react-slot", "lucide-react"],
      "registryDependencies": ["@nk/utils"],
      "files": [
        {
          "path": "components/ui/breadcrumb.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Accessible button built on Base UI with nk product variants.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": ["@nk/utils"],
      "files": [
        {
          "path": "components/ui/button.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/button-variants.ts",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "light": {
          "radius": "0.5rem",
          "background": "#ffffff",
          "foreground": "#000000",
          "primary": "#000000",
          "primary-foreground": "#ffffff",
          "secondary": "#f4f4f4",
          "secondary-foreground": "#000000",
          "muted": "#f4f4f4",
          "muted-foreground": "#525252",
          "accent": "#f4f4f4",
          "accent-foreground": "#000000",
          "destructive": "#dc2626",
          "destructive-foreground": "#ffffff",
          "border": "#e5e5e5",
          "input": "#e5e5e5",
          "ring": "#000000"
        },
        "dark": {
          "background": "#000000",
          "foreground": "#ffffff",
          "primary": "#ffffff",
          "primary-foreground": "#000000",
          "secondary": "#171717",
          "secondary-foreground": "#ffffff",
          "muted": "#171717",
          "muted-foreground": "#a3a3a3",
          "accent": "#171717",
          "accent-foreground": "#ffffff",
          "destructive": "#ef4444",
          "destructive-foreground": "#ffffff",
          "border": "#262626",
          "input": "#262626",
          "ring": "#ffffff"
        }
      }
    },
    {
      "name": "dialog",
      "type": "registry:ui",
      "title": "Dialog",
      "description": "Composable modal dialog on Base UI — trigger, overlay, content, header, footer, and close.",
      "dependencies": ["@base-ui/react", "lucide-react"],
      "registryDependencies": ["@nk/button"],
      "files": [
        {
          "path": "components/ui/dialog.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "light": {
          "radius": "0.5rem",
          "popover": "#ffffff",
          "popover-foreground": "#000000",
          "muted": "#f4f4f4",
          "muted-foreground": "#525252",
          "border": "#e5e5e5",
          "background": "#ffffff",
          "foreground": "#000000",
          "accent": "#f4f4f4",
          "accent-foreground": "#000000",
          "ring": "#000000"
        },
        "dark": {
          "popover": "#0a0a0a",
          "popover-foreground": "#ffffff",
          "muted": "#171717",
          "muted-foreground": "#a3a3a3",
          "border": "#262626",
          "background": "#000000",
          "foreground": "#ffffff",
          "accent": "#171717",
          "accent-foreground": "#ffffff",
          "ring": "#ffffff"
        }
      }
    },
    {
      "name": "progress-button",
      "type": "registry:ui",
      "title": "Progress Button",
      "description": "Download progress button with a stable width while the label updates.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["@nk/button"],
      "files": [
        {
          "path": "components/ui/progress-button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "rail-sidebar",
      "type": "registry:ui",
      "title": "Rail Sidebar",
      "description": "Animated dashed-rail sidebar with nested items and active route rails.",
      "dependencies": ["motion", "next"],
      "registryDependencies": ["@nk/utils"],
      "files": [
        {
          "path": "components/ui/rail-sidebar.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "glyph-flux",
      "type": "registry:ui",
      "title": "GlyphFlux",
      "description": "WebGL gradient field rendered as animated ASCII glyphs with pointer scramble.",
      "registryDependencies": ["@nk/utils"],
      "files": [
        {
          "path": "components/ui/glyph-flux.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "scroll-area",
      "type": "registry:ui",
      "title": "Scroll Area",
      "description": "Native scroll container with custom scrollbars on Base UI.",
      "dependencies": ["@base-ui/react"],
      "registryDependencies": ["@nk/utils"],
      "files": [
        {
          "path": "components/ui/scroll-area.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "scroll-fade",
      "type": "registry:hook",
      "title": "Scroll Fade",
      "description": "CSS edge fades for scroll containers — position-aware by default, optional direction-smart hook.",
      "files": [
        {
          "path": "hooks/use-scroll-fade-direction.ts",
          "type": "registry:hook"
        },
        {
          "path": "styles/scroll-fade.css",
          "type": "registry:file",
          "target": "styles/scroll-fade.css"
        }
      ],
      "css": {
        "@import \"../styles/scroll-fade.css\"": {}
      },
      "docs": "Add `scroll-fade` to the overflow element (or Scroll Area viewport). For direction-aware exit fades, also add `scroll-fade-smart` and `useScrollFadeDirection`. Idle clears the override so position-aware fades resume."
    }
  ]
}
